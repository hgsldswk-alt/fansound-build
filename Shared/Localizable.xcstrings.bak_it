    "paywall.terms": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级功能从收费版首次打开起试用 30 天。试用凭证用于恢复，领取不会延长试用，也不会自动扣费。轻风、整夜、常用定时和已有设置始终可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 30-day trial starts when you first open the paid edition. Saving the trial lets you restore it. It won’t extend the trial or charge you automatically. Low, Overnight, the basic timers and saved settings stay available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進階功能從收費版首次開啟起試用 30 天。試用憑證用於回復，領取不會延長試用，也不會自動扣款。輕風、整夜、常用定時與已有設定一律可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間のお試しは有料版を初めて開いた日から始まります。お試しを保存すると復元できます。延長や自動課金はありません。「弱」「朝まで」、基本のタイマー、保存した設定は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 체험은 유료 버전을 처음 열 때 시작됩니다. 체험을 저장하면 복원할 수 있습니다. 체험이 늘어나거나 자동 결제되지 않습니다. 약, 밤새, 기본 타이머, 저장한 설정은 계속 쓸 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 30-tägige Testphase beginnt beim ersten Öffnen der Kaufversion. Wenn du sie sicherst, kannst du sie wiederherstellen. Sie wird dadurch nicht verlängert und es wird nichts automatisch abgebucht. Niedrig, Ganze Nacht, die Basis-Timer und gespeicherte Einstellungen bleiben verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba de 30 días empieza al abrir por primera vez la edición de pago. Guardarla te permite restaurarla. No la alarga ni te cobra automáticamente. Baja, Toda la noche, los temporizadores básicos y los ajustes guardados siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai de 30 jours commence à la première ouverture de l’édition payante. L’enregistrer permet de le restaurer. Il n’allonge pas l’essai et ne déclenche aucun paiement automatique. Faible, Toute la nuit, les minuteurs de base et les réglages enregistrés restent disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste de 30 dias começa quando você abre a edição paga pela primeira vez. Salvar o teste permite restaurá-lo. Ele não estende o teste nem gera cobrança automática. Baixa, A noite toda, os timers básicos e os ajustes salvos continuam disponíveis."
          }
        }
      }
    },

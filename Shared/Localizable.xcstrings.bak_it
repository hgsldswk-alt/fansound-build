    "paywall.details": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断解锁中风、强风、15／45／90 分钟定时，以及「播放上次设置」快捷指令。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase unlocks Medium, High, 15/45/90-minute timers and the Play Last Fan Settings shortcut."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷解鎖中風、強風、15／45／90 分鐘定時，以及「播放上次設定」捷徑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で「中」「強」、15・45・90分タイマー、「前回の扇風機設定で再生」ショートカットが解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구매로 중·강, 15/45/90분 타이머, 마지막 선풍기 설정 재생 단축어가 열립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf schaltet Mittel, Hoch, die 15/45/90-Minuten-Timer und den Kurzbefehl „Letzte Ventilatoreinstellungen abspielen“ frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra desbloquea Media, Alta, los temporizadores de 15/45/90 minutos y el atajo «Reproducir últimos ajustes del ventilador»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat débloque Moyen, Fort, les minuteurs de 15/45/90 minutes et le raccourci Reprendre les derniers réglages."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra desbloqueia Média, Alta, timers de 15/45/90 minutos e o atalho Tocar últimos ajustes."
          }
        }
      }
    },

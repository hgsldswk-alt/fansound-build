    "privacy.local": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇声在设备上实时合成。设置和合格夜次只保存在本机。无需账号，无广告或统计追踪。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan sounds are generated on your device. Settings and qualifying nights are stored locally. There’s no account, advertising or analytics."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "風扇聲在裝置上即時合成。設定與符合條件的夜次只儲存在本機。無須帳號，沒有廣告或分析追蹤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扇風機の音は端末上で生成されます。設定と記録した夜は端末内に保存されます。アカウント、広告、分析ツールはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선풍기 소리는 기기에서 만들어집니다. 설정과 기록한 밤은 기기에만 저장됩니다. 계정, 광고, 분석이 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ventilatorgeräusche werden auf deinem Gerät erzeugt. Einstellungen und gezählte Nächte werden lokal gespeichert. Kein Konto, keine Werbung, keine Analyse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos se generan en tu dispositivo. Los ajustes y las noches contadas se guardan localmente. Sin cuenta, sin anuncios, sin analíticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons de ventilateur sont générés sur ton appareil. Les réglages et les nuits validées restent en local. Pas de compte, de publicité ni d’analyse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sons de ventilador são gerados no seu dispositivo. Os ajustes e as noites registradas ficam salvos localmente. Sem conta, anúncios ou análises."
          }
        }
      }
    },
    "privacy.apple": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买、恢复购买和评分由 Apple 的系统服务处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple handles purchases, restores and ratings through its system services."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買、回復購買與評分由 Apple 的系統服務處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入、復元、評価はAppleがシステムのサービスで処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매, 복원, 평가는 Apple 시스템 서비스가 처리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe, Wiederherstellungen und Bewertungen wickelt Apple über seine Systemdienste ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gestiona las compras, restauraciones y calificaciones con sus servicios del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gère les achats, les restaurations et les notes via ses services système."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple cuida das compras, restaurações e avaliações pelos serviços do sistema."
          }
        }
      }
    },
    "privacy.sharing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你选择分享时，才会把图片、口令或链接交给你选定的接收方。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, codes and links are shared only with the recipients you choose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你選擇分享時，圖片、代碼或連結才會傳給你選定的接收對象。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像、コード、リンクは、あなたが選んだ相手にだけ共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지, 코드, 링크는 직접 고른 사람에게만 공유됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, Codes und Links werden nur mit den Empfängern geteilt, die du auswählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes, códigos y enlaces solo se comparten con quien tú elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images, codes et liens ne sont partagés qu’avec les destinataires que tu choisis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens, códigos e links são compartilhados apenas com quem você escolher."
          }
        }
      }
    },

    "share.textOvernight": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我用%@档，整夜听风扇声。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I use the %@ setting for overnight fan sound."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我用%@檔，整夜聽風扇聲。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜は「%@」の設定で扇風機の音を流しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤새 선풍기 소리를 %@ 설정으로 들어요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich nutze nachts die Einstellung %@ für Ventilatorgeräusche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso el ajuste %@ para el sonido de ventilador por la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’utilise le réglage %@ pour dormir avec un ventilateur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso o ajuste %@ para dormir com som de ventilador."
          }
        }
      }
    },
    "share.textTimed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我用%1$@档，定时 %2$@，到点声音慢慢淡下去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I use %1$@ with a %2$@ timer that fades out softly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我用%1$@檔，設定 %2$@，到時聲音慢慢淡下去。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ に %2$@ のタイマーで、最後はやさしくフェードアウトさせています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 %2$@ 타이머로 들으면 끝날 때 부드럽게 줄어들어요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich nutze %1$@ mit einem %2$@-Timer, der sanft ausblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso %1$@ con un temporizador de %2$@ que baja el volumen suavemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’utilise %1$@ avec un minuteur de %2$@ qui s’éteint en douceur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso %1$@ com um timer de %2$@ que desliga suavemente."
          }
        }
      }
    },

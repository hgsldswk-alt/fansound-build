    "privacy.local": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇声在设备上实时合成。设置和合格夜次只保存在本机。无需账号，无广告或统计追踪。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan sounds are generated on your device. Settings and qualifying nights are stored locally. There’s no account, advertising or analytics."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "風扇聲在裝置上即時合成。設定與符合條件的夜次只儲存在本機。無須帳號，沒有廣告或分析追蹤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扇風機の音は端末上で生成されます。設定と記録した夜は端末内に保存されます。アカウント、広告、分析ツールはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선풍기 소리는 기기에서 만들어집니다. 설정과 기록한 밤은 기기에만 저장됩니다. 계정, 광고, 분석이 없습니다."
          }
        }
      }
    },
    "privacy.apple": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买、恢复购买和评分由 Apple 的系统服务处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple handles purchases, restores and ratings through its system services."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買、回復購買與評分由 Apple 的系統服務處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入、復元、評価はAppleがシステムのサービスで処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

          }
        }
      }
    },
    "privacy.sharing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你选择分享时，才会把图片、口令或链接交给你选定的接收方。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, codes and links are shared only with the recipients you choose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你選擇分享時，圖片、代碼或連結才會傳給你選定的接收對象。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像、コード、リンクは、あなたが選んだ相手にだけ共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지, 코드, 링크는 직접 고른 사람에게만 공유됩니다."
          }
        }
      }
    },
